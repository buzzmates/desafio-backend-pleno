{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "verbose": false,
  "silent": true,
  "errorOnDeprecated": false,
  "notify": false,
  "bail": false,
  "clearMocks": true,
  "resetMocks": true,
  "restoreMocks": true,
  "reporters": ["default"],
  "maxWorkers": 1
}
