# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/orders_db"

# Database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=orders_db

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis connection string for BullMQ queues
# Format: redis://HOST:PORT or rediss:// for TLS
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""


# =============================================================================
# EXTERNAL API KEYS
# =============================================================================
# Currency Conversion API (e.g., ExchangeRate-API, CurrencyLayer)
CURRENCY_API_KEY="your_currency_api_key_here"
CURRENCY_API_URL="https://api.exchangerate-api.com/v4/latest/"

# Address Validation API (e.g., ViaCEP for Brazilian addresses)
ADDRESS_API_KEY="your_address_api_key_here"
ADDRESS_API_URL="https://viacep.com.br/ws/"

# Product Verification API
PRODUCT_API_KEY="your_product_api_key_here"
PRODUCT_API_URL="https://api.example.com/products/"

# =============================================================================
# QUEUE CONFIGURATION
# =============================================================================
# Concurrency settings for each queue processor
QUEUE_CONCURRENCY_CURRENCY="5"
QUEUE_CONCURRENCY_ADDRESS="10"
QUEUE_CONCURRENCY_PRODUCT="3"

# Retry configuration
QUEUE_MAX_ATTEMPTS="5"
QUEUE_BACKOFF_TYPE="exponential"
QUEUE_BACKOFF_DELAY="1000"

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT="3000"
NODE_ENV="development"

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL="debug"
ENABLE_SWAGGER="true"
